# Bootstrap with CPA unreachable until stored preferences have been verified.
OMCPA_CPA_BASE_URL=http://127.0.0.1:8317
OMCPA_BASE_PATH=/
OMCPA_ENV_FILE=/dev/null
OMCPA_LISTEN_ADDR=127.0.0.1:18317
OMCPA_DATA_DIR=/home/REPLACE_USER/.local/share/oh-my-cpa/data
OMCPA_USAGE_INGEST_MODE=off
OMCPA_USAGE_RETENTION_DAYS=90
OMCPA_USAGE_INBOX_RETENTION_DAYS=7
OMCPA_UPDATER_ENABLED=false
OMCPA_UPDATE_CHECK_ENABLED=false
OMCPA_UPDATE_CHECK_ON_PAGE_LOAD=false
TZ=Etc/UTC
# Add management and master keys privately during installation; never commit them.
